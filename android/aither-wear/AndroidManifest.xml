<?xml version="1.0" encoding="utf-8"?>
<!-- Aither on Wear OS: a standalone watch app (its own Wi-Fi/LTE, no phone, no Play Services).
     Same package and release certificate as the phone app, the pairing Wear OS expects of a
     phone/watch pair. Built by ../aither/build.py with the wear flag. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aitherium.aither"
    android:versionCode="16"
    android:versionName="0.3.29">

    <!-- Wear OS 3 (API 30) and up; Pixel Watch 4 ships Wear OS 6 (API 36) -->
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Talk to Aither: asked for on the first Talk; heard by the on-device recognizer only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- a short tick on the wrist when the mic re-opens for the next turn of a conversation -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Add to my devices (WearBlePair): the watch advertises and answers one phone over
         Bluetooth LE only while that screen is open; it never scans. Wear OS 4+ (API 33+)
         asks at runtime; Wear OS 3 (API 30) takes the install-time pair. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Over-the-air updates without Play (WearUpdater): the app updates ITSELF from the
         GitHub release with no prompt (Android allows a self-update without user action);
         the watch face, another package, asks for one tap. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the background device check-in (WearBeatJob) is a persisted job, and it is re-armed
         after a reboot or an update (WearBootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <!-- the Aither watch face, kept current by WearUpdater when it is installed -->
        <package android:name="com.aitherium.aither.watchface" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="Aither"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".WearActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Talk to Aither": a second launcher entry that opens straight into listening
             (WearActivity.TALK_ALIAS). It can be put on the watch's button:
             Settings > Gestures > Press and hold button (or Quick launch). -->
        <activity-alias
            android:name=".TalkToAither"
            android:label="Talk to Aither"
            android:targetActivity=".WearActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The Aither Tile (WearTile): Talk + what waits for you, a swipe from the face.
             Bound only by the system's tile host (BIND_TILE_PROVIDER). -->
        <service
            android:name=".WearTile"
            android:label="Aither"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <receiver android:name=".WearUpdateResult" android:exported="false" />

        <!-- the device check-in every ~15 minutes with the app closed, so an idle watch stays
             online in "my devices"; bound only by JobScheduler -->
        <service
            android:name=".WearBeatJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".WearBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".WearBlePair"
            android:label="Add to my devices"
            android:exported="false" />
    </application>
</manifest>
