<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aitherium.aither"
    android:versionCode="28"
    android:versionName="0.3.25">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- self-update of the verified, release-signed APK: silent when Android allows it
         (Updater.installQuietly), else the one-tap notification (the store build drops both) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- lets the updater ask to become the update owner (Updater.writeSession); normal, auto-granted -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- the calendar_read agent tool: asked for only when the owner turns that tool on -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Ask Aither's Talk button: asked for on its first tap; heard by the on-device recognizer only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Live camera: asked for on the first tap of the camera button in a chat; frames go only
         to the signed-in owner's live-vision session, are never stored, and stop when the
         screen does. A child's phone needs a guardian's allow (Genesis refuses otherwise). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Nearby devices (BlePair): Bluetooth only while that screen, or "Add this phone nearby",
         is open; never in the background, never for location. Android 12+ asks at runtime.
         Android 10/11 get the install-time pair for advertising only: scanning there would
         need location, so those phones approve with a code instead (NearbyDevicesActivity). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Android 11+ hides other apps' services: the speech recognizer and the voice that reads answers -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Aither"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- AitherOS itself (the PWA), full screen. NoActionBar: the shell draws its own top
             bar; the system one stacked a second gray "Aither" bar above it (owner, 2026-10-07) -->
        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- aitherium.com links open here (Hearth, Family, Learn: /?app=...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aitherium.com" />
            </intent-filter>
            <!-- app.aitherium.com is a verified App Link (its /.well-known/assetlinks.json names
                 this package and the release certificate): its links and QR codes open here,
                 not in the browser -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.aitherium.com" />
            </intent-filter>
            <!-- a QR or link that must open in this app, not the browser:
                 aither://open?url=https://app.aitherium.com/... (only aitherium.com pages load) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aither" android:host="open" />
            </intent-filter>
            <!-- App Actions: actions.intent.OPEN_APP_FEATURE ("open Hearth in Aither") capability
                 only; feature shortcuts stay dynamic (Shortcuts.apply). Assistant/Gemini read these once the app is on Play. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- this phone's extras: lend memory, local AI, pairing links -->
        <activity
            android:name=".SettingsActivity"
            android:label="Aither on this phone"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- the owner's pairing link: aitherkv://pair?r=<relay>&i=<identity>&c=<code>&d=<device>&mb=<MB> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aitherkv" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- "Link a device": sign a watch, TV or laptop in by its code. The watch's QR is an
             app.aitherium.com App Link (MainActivity hands it here); aither://link?code= and the
             IdP's /link page open here too. Nothing is approved without the owner's tap. -->
        <activity
            android:name=".LinkActivity"
            android:label="Link a device"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aither" android:host="link" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="idp.aitherium.com" android:path="/link" />
            </intent-filter>
        </activity>

        <!-- Nearby devices: approve a watch or new phone in Bluetooth range (SAS checked by the
             owner, code minted by Identity, which refuses a child), and this phone's own
             "Add this phone nearby". Not exported: only Settings opens them. -->
        <activity
            android:name=".NearbyDevicesActivity"
            android:label="Nearby devices"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />
        <activity
            android:name=".BleJoinActivity"
            android:label="Add this phone nearby"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />
        <!-- "Ask Aither" from another app: Share (a Gemini answer, a page), the text-selection
             menu, and aither://ask?q=. The text becomes a draft in Ask Aither; nothing is asked
             until the person taps Send (ShareActivity). -->
        <activity
            android:name=".ShareActivity"
            android:label="Ask Aither"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aither" android:host="ask" />
            </intent-filter>
        </activity>

        <!-- Aither as the phone's assistant (Android's assistant role, granted by the owner) -->
        <activity
            android:name=".AssistActivity"
            android:label="Ask Aither"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "What's in this picture?": take, pick or share a picture; the model on this phone
             looks at it (Vision), or Aither online on the owner's tap. A share only fills the
             picture in; nothing is sent until the owner taps Ask. -->
        <activity
            android:name=".DescribeActivity"
            android:label="What's in this picture?"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- the one file the camera app writes for DescribeActivity (granted per capture) -->
        <provider
            android:name=".ShotProvider"
            android:authorities="com.aitherium.aither.shot"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- measures the on-device agent; only adb can start it (DUMP), tools run dry -->
        <activity
            android:name=".EvalActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- the one tap on the update notification: hands a verified APK to the installer -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".HolderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Lends memory to the owner's own AI model: holds its KV cache and answers attention over it" />
        </service>

        <service
            android:name=".LlmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the owner's small AI model on this phone for the AitherOS app (local only)" />
        </service>

        <!-- Family Shield: a DNS-only VPN (one fake resolver address is routed, nothing else)
             that sends a child's lookups to the household filter. Only the system binds it. -->
        <service
            android:name=".ShieldVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Family internet filter set by the household's guardian: resolves this phone's DNS lookups through the family's filter" />
        </service>

        <!-- on duty for approvals: one outbound long-poll on the household inbox while the
             guardian leaves it on (no Google Play Services; nothing inbound) -->
        <service
            android:name=".DutyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Delivers the household's approval requests to the guardian in real time, without Google Play Services, while the guardian keeps it on" />
        </service>

        <!-- Approve / Deny on an approval notification: only this app's own PendingIntents -->
        <receiver android:name=".NoticeActionReceiver" android:exported="false" />

        <!-- The outcome of a quiet self-update; anything but success becomes the notification -->
        <receiver android:name=".UpdateResult" android:exported="false" />

        <!-- Family Shield's watch: tells the household when the filter is off, asks the child
             to turn it back on. The job runs every 15 minutes; the receiver gets the
             ConnectivityManager callback for VPN networks coming and going. -->
        <service
            android:name=".ShieldWatch"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".ShieldWatch$Changed" android:exported="false" />
        <!-- App functions (Android 16+): what Gemini, or another agent Android lets run app
             functions, may ask of Aither. Only the system binds it (BIND_APP_FUNCTION_SERVICE);
             the policy is GeminiFunctions. The index files are hand-written in assets/ (what the
             androidx KSP processor would generate), v1 for Android 16's first indexer, v2 and
             its schema for the current one. -->
        <service
            android:name=".AitherFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property
                android:name="android.app.appfunctions"
                android:value="app_functions.xml" />
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="aither_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_metadata" />

        <service
            android:name=".HeartbeatJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- the "Aither" home-screen widget: Talk to Aither, Learn, Family. Not exported:
             the system delivers APPWIDGET_UPDATE regardless, and no other app needs it -->
        <receiver
            android:name=".AitherWidget"
            android:label="Aither"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aither_info" />
        </receiver>

        <!-- the "Talk to Aither" Quick Settings tile. Exported only because System UI binds
             it; the permission means only the system can -->
        <service
            android:name=".TalkTile"
            android:label="Talk to Aither"
            android:icon="@drawable/aither_mark"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
