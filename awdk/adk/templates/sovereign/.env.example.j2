# {{ agent_display_name }} — Configuration
# Copy to .env and edit values.

# LLM Provider: portal | aitheros | ollama | deepseek | openai | anthropic | gemini | custom
{{ env_prefix }}LLM_PROVIDER=portal
{{ env_prefix }}LLM_FALLBACK=

# Provider API Keys (only the active provider's key is required)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Security
{{ env_prefix }}SECRET_KEY=change-me-to-a-random-string
{{ env_prefix }}API_KEY=

# Infrastructure
{{ env_prefix }}QDRANT_URL=http://localhost:6333
{{ env_prefix }}EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
{{ env_prefix }}UPLOAD_DIR=./data/uploads
{{ env_prefix }}EXPORT_DIR=./data/exports
{{ env_prefix }}DB_PATH=./data/{{ db_name }}

# CORS
{{ env_prefix }}CORS_ORIGINS=

# Portal registration (optional)
{{ env_prefix }}AITHERIUM_AGENT_ID=
{{ env_prefix }}AITHERIUM_AGENT_NAME=

# Multi-instance federation
{{ env_prefix }}INSTANCE_ID=
{{ env_prefix }}TENANT_ID=
{{ env_prefix }}WORKSPACE_ID=default
{{ env_prefix }}PORTAL_TOKEN=
{{ env_prefix }}HEARTBEAT_INTERVAL=60
{{ env_prefix }}HEARTBEAT_ENABLED=true
