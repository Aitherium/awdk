"""Document upload and management."""

from __future__ import annotations

import logging
import shutil
import uuid
from pathlib import Path

from fastapi import APIRouter, Depends, File, Form, HTTPException, UploadFile
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from ..auth import UserContext, get_user_context
from ..config import settings
from ..database import get_db
from ..models import DocumentRecord, DocumentUploadResponse
from ..services import rag

_log = logging.getLogger("{{ log_name }}.documents")

router = APIRouter(prefix="/api/documents", tags=["documents"])


@router.post("/upload", response_model=DocumentUploadResponse)
async def upload_document(
    file: UploadFile = File(...),
    doc_type: str = Form("other"),
    user: UserContext = Depends(get_user_context),
    db: AsyncSession = Depends(get_db),
):
    doc_id = str(uuid.uuid4())
    suffix = Path(file.filename).suffix
    save_path = settings.upload_dir / f"{doc_id}{suffix}"

    with open(save_path, "wb") as f:
        shutil.copyfileobj(file.file, f)

    chunk_count, _ = rag.ingest_document(
        save_path, doc_id, doc_type, file.filename, tenant_id=user.tenant_id,
    )

    record = DocumentRecord(
        id=doc_id,
        tenant_id=user.tenant_id,
        filename=file.filename,
        doc_type=doc_type,
        chunk_count=chunk_count,
        user_id=user.user_id,
    )
    db.add(record)
    await db.commit()

    return DocumentUploadResponse(
        doc_id=doc_id,
        filename=file.filename,
        doc_type=doc_type,
        chunks_created=chunk_count,
    )


@router.get("")
async def list_documents(
    user: UserContext = Depends(get_user_context),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select(DocumentRecord)
        .where(DocumentRecord.tenant_id == user.tenant_id)
        .order_by(DocumentRecord.uploaded_at.desc())
    )
    return [
        {
            "id": d.id,
            "filename": d.filename,
            "doc_type": d.doc_type,
            "uploaded_at": d.uploaded_at.isoformat() if d.uploaded_at else None,
            "chunk_count": d.chunk_count,
        }
        for d in result.scalars().all()
    ]


@router.delete("/{doc_id}")
async def delete_document(
    doc_id: str,
    user: UserContext = Depends(get_user_context),
    db: AsyncSession = Depends(get_db),
):
    result = await db.execute(
        select(DocumentRecord).where(
            DocumentRecord.id == doc_id,
            DocumentRecord.tenant_id == user.tenant_id,
        )
    )
    doc = result.scalar_one_or_none()
    if not doc:
        raise HTTPException(404, "Document not found")

    rag.delete_document(doc_id)

    for f in settings.upload_dir.glob(f"{doc_id}.*"):
        f.unlink(missing_ok=True)

    # Citation-aware cache eviction (agent_core) — only flush conversations
    # whose memories cite this document. Falls back to tenant flush on error.
    from .chat import _cache, _memory_scope
    from ..agent_memory import get_memory_client
    from ..agent_core import (
        evict_cached_conversations_referencing,
        tombstone_document,
    )
    try:
        # Memory store uses the scoped key; cache uses raw tenant_id.
        await evict_cached_conversations_referencing(
            tenant_id=_memory_scope(user),
            document_id=doc_id,
            memory_client=get_memory_client(),
            cache=None,  # handle cache separately with raw tenant key
        )
        for _k in [k for k in _cache if k[0] == user.tenant_id]:
            del _cache[_k]
    except Exception as _ev_exc:  # noqa: BLE001
        _log.warning("citation-aware evict failed (%s); flushing tenant", _ev_exc)
        for _k in [k for k in _cache if k[0] == user.tenant_id]:
            del _cache[_k]

    # Tombstone if the document model supports it; otherwise hard-delete.
    if tombstone_document(doc):
        db.add(doc)
    else:
        await db.delete(doc)
    await db.commit()
    return {"status": "deleted", "doc_id": doc_id}
