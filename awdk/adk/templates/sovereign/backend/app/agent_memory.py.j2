"""Per-process agent_core memory singleton for this app.

Constructs LocalMemoryStore + UnifiedMemoryClient + ConsolidationDaemon
lazily on first access. The host app's `main.py` lifespan should call
`init_memory()` on startup and `shutdown_memory()` on shutdown.

Tenant resolution: this app already has `app.auth.get_user_context` —
the admin router needs a sync way to read tenant_id from `Request`.
We mirror the auth dependency's logic here.

Standalone — depends only on stdlib + agent_core. Safe to vendor.
"""

from __future__ import annotations

import logging
import os
from pathlib import Path

from fastapi import Request

from .agent_core import (
    ConsolidationDaemon,
    LocalMemoryStore,
    MemoryMode,
    MiniSixPillarsKernel,
    SpiritBridge,
    UnifiedMemoryClient,
)

log = logging.getLogger("agent_memory")

# Persistent path for the local memory DB. Falls back next to the main
# app DB (./data/) when unset.
_DEFAULT_DB = os.environ.get(
    "AGENT_MEMORY_DB",
    str(Path("./data/agent_memory.db").resolve()),
)

# Singletons (initialised once per process).
_store: LocalMemoryStore | None = None
_client: UnifiedMemoryClient | None = None
_daemon: ConsolidationDaemon | None = None
_kernel: MiniSixPillarsKernel | None = None


async def init_memory() -> UnifiedMemoryClient:
    """Construct and initialise the memory singletons. Safe to call repeatedly."""
    global _store, _client, _daemon
    if _client is not None:
        return _client

    db_path = os.environ.get("AGENT_MEMORY_DB", _DEFAULT_DB)
    Path(db_path).parent.mkdir(parents=True, exist_ok=True)
    _store = LocalMemoryStore(db_path)
    await _store.init()

    bridge = SpiritBridge()  # reads SPIRIT_URL / MEMORYHUB_URL / WORKING_MEMORY_URL
    mode_raw = (os.environ.get("MEMORY_MODE") or "hybrid").strip().lower()
    try:
        mode = MemoryMode(mode_raw)
    except ValueError:
        mode = MemoryMode.HYBRID

    _client = UnifiedMemoryClient(store=_store, bridge=bridge, mode=mode)
    await _client.init()

    interval = float(os.environ.get("AGENT_MEMORY_CONSOLIDATION_INTERVAL", "60"))
    _daemon = ConsolidationDaemon(_store, interval_seconds=interval)
    _daemon.start()

    log.info(
        "agent_core memory initialised (db=%s mode=%s bridge_enabled=%s)",
        db_path, mode.value, bridge.enabled,
    )
    return _client


async def shutdown_memory() -> None:
    global _daemon
    if _daemon is not None:
        await _daemon.stop()
        _daemon = None


def get_memory_client() -> UnifiedMemoryClient:
    """Return the singleton client. Raises if init_memory() not called yet."""
    if _client is None:
        raise RuntimeError(
            "agent_core memory not initialised — "
            "call init_memory() from the app lifespan first"
        )
    return _client


def get_memory_kernel(*, llm_chat, rag_search=None):
    """Return a process-wide MiniSixPillarsKernel bound to the given callables.

    Construct on demand because each chat router may want different llm/rag
    callbacks. After first construction the kernel is cached.
    """
    global _kernel
    if _kernel is None:
        _kernel = MiniSixPillarsKernel(
            memory=get_memory_client(),
            llm_chat=llm_chat,
            rag_search=rag_search,
        )
    return _kernel


def resolve_tenant_id(request: Request) -> str:
    """Extract tenant_id from request for the admin router.

    Order: (1) explicit X-Tenant-ID header, (2) session cookie + auth lookup,
    (3) "default" so single-tenant deployments still work.
    """
    hdr = request.headers.get("x-tenant-id")
    if hdr:
        return hdr.strip()
    # The host app's auth system may have populated request.state.
    state = getattr(request, "state", None)
    if state is not None:
        user = getattr(state, "user", None)
        if user is not None:
            tid = getattr(user, "tenant_id", None)
            if tid:
                return str(tid)
    return "default"
