"""{{ agent_display_name }} — main FastAPI application.

Generated by: adk create {{ agent_name }} --template sovereign
"""

import asyncio
import logging
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from fastapi.staticfiles import StaticFiles

from .brain_pack import get_brain_pack
from .config import settings, _PROJECT_ROOT
from .database import init_db
from .routers import auth, chat, documents, feedback

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(name)s %(levelname)s %(message)s")
log = logging.getLogger("{{ log_name }}")

_background_tasks: list[asyncio.Task] = []


@asynccontextmanager
async def lifespan(app: FastAPI):
    pack = get_brain_pack()
    log.info(
        "Starting %s (pack=%s provider=%s mode=%s)",
        pack.app_name, pack.id, settings.llm_provider, settings.deployment_mode,
    )
    await init_db()
    log.info("Database initialized at %s", settings.database_url or settings.db_path)

    # Register with portal.aitherium.com (non-blocking, non-fatal)
    try:
        from .services.portal_registration import register_with_portal
        await register_with_portal()
    except Exception as e:
        log.debug("Portal registration skipped: %s", e)

    # Start heartbeat loop (federation-protocol, background)
    if settings.heartbeat_enabled and settings.tenant_id:
        try:
            from .services.portal_registration import start_heartbeat_loop
            task = asyncio.create_task(start_heartbeat_loop())
            _background_tasks.append(task)
        except Exception as e:
            log.debug("Heartbeat loop not started: %s", e)

    # Register in local agent registry for AitherShell discovery
    try:
        from adk.agent_registry import register_local_agent
        register_local_agent(
            "{{ agent_name }}",
            settings.port,
            capabilities=["chat", "rag", "document_upload"],
            instance_id=settings.instance_id,
        )
    except Exception as e:
        log.debug("Local agent registration skipped: %s", e)

    # Initialise local 5-tier agent memory (best-effort).
    try:
        from .agent_memory import init_memory
        await init_memory()
        log.info("agent_core memory initialised")
    except Exception as e:
        log.warning("agent_core memory init failed (non-fatal): %s", e)

    yield

    try:
        from .agent_memory import shutdown_memory
        await shutdown_memory()
    except Exception:
        pass

    for task in _background_tasks:
        task.cancel()
    log.info("Shutting down %s", pack.app_name)


_pack = get_brain_pack()
app = FastAPI(
    title=_pack.app_name,
    description=f"AI agent: {_pack.company_name or _pack.app_name}",
    version="0.1.0",
    lifespan=lifespan,
)

# CORS
if settings.cors_origins:
    _origins = [o.strip() for o in settings.cors_origins.split(",") if o.strip()]
    _allow_credentials = True
elif settings.deployment_mode == "saas":
    _origins = [
        "https://portal.aitherium.com",
        "https://app.aitherium.com",
    ]
    _allow_credentials = True
else:
    _origins = ["*"]
    _allow_credentials = False
app.add_middleware(
    CORSMiddleware,
    allow_origins=_origins,
    allow_credentials=_allow_credentials,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.middleware("http")
async def api_key_middleware(request: Request, call_next):
    if settings.api_key and request.url.path.startswith("/api/"):
        if request.url.path == "/api/health":
            return await call_next(request)
        auth_header = request.headers.get("Authorization", "")
        if auth_header != f"Bearer {settings.api_key}":
            return JSONResponse(status_code=401, content={"detail": "Invalid or missing API key"})
    return await call_next(request)


@app.get("/api/health")
async def health():
    pack = get_brain_pack()
    return {
        "status": "ok",
        "service": pack.app_name,
        "pack": pack.id,
        "llm_provider": settings.llm_provider,
        "deployment_mode": settings.deployment_mode,
    }


@app.get("/api/config/embed")
async def get_embed_config():
    """Returns embed/iframe configuration for Portal integration.

    The frontend reads ALL branding, labels, and feature flags from here.
    Zero hardcoded brand strings in the UI.
    """
    pack = get_brain_pack()
    return {
        "app_name": pack.app_name,
        "company_name": pack.company_name or "",
        "embed_path": "/",
        "features": ["upload", "chat", "settings"],
        "accepts_drop": True,
        "drop_endpoint": "/api/documents/upload",
        "accepted_types": [".pdf", ".docx", ".doc", ".xlsx", ".txt", ".md", ".csv"],
        "icon": "file-text",
        "welcome_message": pack.welcome_message,
        "ui_labels": pack.ui_labels,
        "doc_types": [
            {"id": dt.id, "label": dt.label, "extract": dt.extract}
            for dt in pack.doc_types.values()
        ] if pack.doc_types else [],
        "roles": {
            name: {"description": role.description, "permissions": list(role.permissions)}
            for name, role in pack.roles.items()
        },
    }


app.include_router(auth.router)
app.include_router(chat.router)
app.include_router(documents.router)

# 5-tier agent_core memory admin (/api/memory/*)
try:
    from .agent_memory import get_memory_client, resolve_tenant_id
    from .agent_core import build_memory_router
    app.include_router(build_memory_router(get_memory_client, resolve_tenant_id))
except Exception as _e:
    log.debug("agent_core admin router not mounted: %s", _e)
app.include_router(feedback.router)

# Static frontend (catch-all, MUST be last)
frontend_dist = _PROJECT_ROOT / "frontend-dist"
frontend_legacy = _PROJECT_ROOT / "frontend"
if frontend_dist.exists() and (frontend_dist / "index.html").exists():
    app.mount("/", StaticFiles(directory=str(frontend_dist), html=True), name="frontend")
elif frontend_legacy.exists():
    app.mount("/", StaticFiles(directory=str(frontend_legacy), html=True), name="frontend")
