"""Multi-provider LLM gateway.

Provider selection: ``{{ env_prefix }}LLM_PROVIDER`` env var or config.
Fallback chain: primary -> ``{{ env_prefix }}LLM_FALLBACK`` (if configured).
"""

from __future__ import annotations

import logging
import re
from dataclasses import dataclass
from typing import Any

import httpx

from ..agent_core.bridge import tls_verify
from ..brain_pack import get_brain_pack
from ..config import settings

log = logging.getLogger("{{ log_name }}.llm")


def _system_prompt() -> str:
    return get_brain_pack().system_prompt


_THINK_RE = re.compile(r"<think>.*?</think>\s*", re.DOTALL)


def _strip_think_tags(text: str) -> str:
    return _THINK_RE.sub("", text).strip()


@dataclass
class LLMResult:
    text: str
    provider: str
    model: str
    prompt_tokens: int = 0
    completion_tokens: int = 0
    total_tokens: int = 0
    cost_usd: float = 0.0
    is_fallback: bool = False

    def to_dict(self) -> dict[str, Any]:
        return {
            "provider": self.provider,
            "model": self.model,
            "prompt_tokens": self.prompt_tokens,
            "completion_tokens": self.completion_tokens,
            "total_tokens": self.total_tokens,
            "cost_usd": round(self.cost_usd, 6),
            "is_fallback": self.is_fallback,
        }


async def _call_openai_compat(
    base_url: str, api_key: str, model: str, messages: list[dict], max_tokens: int = 4096,
) -> dict:
    """Generic OpenAI-compatible API call."""
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    async with httpx.AsyncClient(timeout=120, verify=tls_verify()) as c:
        r = await c.post(
            f"{base_url.rstrip('/')}/v1/chat/completions",
            json={"model": model, "messages": messages, "max_tokens": max_tokens},
            headers=headers,
        )
        r.raise_for_status()
        data = r.json()

    text = data["choices"][0]["message"]["content"]
    usage = data.get("usage", {})
    return {"text": text, "model": data.get("model", model), "usage": usage}


async def _call_provider(
    provider: str, messages: list[dict], max_tokens: int = 4096,
) -> dict:
    """Route to the correct provider."""
    if provider == "portal":
        return await _call_openai_compat(
            settings.portal_url, settings.portal_api_key, settings.portal_model, messages, max_tokens,
        )
    if provider == "aitheros":
        async with httpx.AsyncClient(timeout=120, verify=tls_verify()) as c:
            r = await c.post(
                f"{settings.aitheros_url.rstrip('/')}/llm/generate",
                json={
                    "messages": messages, "model": settings.aitheros_model,
                    "max_tokens": max_tokens, "stream": False,
                    "priority": "USER", "caller": "{{ agent_name }}",
                },
            )
            r.raise_for_status()
            data = r.json()
        text = data.get("text") or data.get("content") or data.get("response", str(data))
        if "choices" in data:
            text = data["choices"][0]["message"]["content"]
        return {"text": text, "model": data.get("model", "auto"), "usage": data.get("usage", {})}
    if provider == "ollama":
        return await _call_openai_compat(
            settings.ollama_url, "", settings.ollama_model, messages, max_tokens,
        )
    if provider == "deepseek":
        return await _call_openai_compat(
            settings.deepseek_url, settings.deepseek_api_key, settings.deepseek_model, messages, max_tokens,
        )
    if provider == "openai":
        return await _call_openai_compat(
            settings.openai_url, settings.openai_api_key, settings.openai_model, messages, max_tokens,
        )
    if provider == "anthropic":
        return await _call_openai_compat(
            "https://api.anthropic.com", settings.anthropic_api_key, settings.anthropic_model, messages, max_tokens,
        )
    if provider == "gemini":
        return await _call_openai_compat(
            "https://generativelanguage.googleapis.com/v1beta/openai",
            settings.gemini_api_key, settings.gemini_model, messages, max_tokens,
        )
    if provider == "custom":
        return await _call_openai_compat(
            settings.custom_llm_url, settings.custom_llm_api_key, settings.custom_llm_model, messages, max_tokens,
        )
    raise ValueError(f"Unknown LLM provider: {provider}")


async def _call_llm(messages: list[dict], max_tokens: int = 4096) -> LLMResult:
    provider = settings.llm_provider
    try:
        result = await _call_provider(provider, messages, max_tokens)
        usage = result.get("usage", {})
        return LLMResult(
            text=_strip_think_tags(result["text"]),
            provider=provider, model=result.get("model", ""),
            prompt_tokens=usage.get("prompt_tokens", 0),
            completion_tokens=usage.get("completion_tokens", 0),
            total_tokens=usage.get("total_tokens", 0),
        )
    except Exception as e:
        if settings.llm_fallback and settings.llm_fallback != provider:
            log.warning("Provider '%s' failed (%s), falling back to '%s'", provider, e, settings.llm_fallback)
            result = await _call_provider(settings.llm_fallback, messages, max_tokens)
            usage = result.get("usage", {})
            return LLMResult(
                text=_strip_think_tags(result["text"]),
                provider=settings.llm_fallback, model=result.get("model", ""),
                prompt_tokens=usage.get("prompt_tokens", 0),
                completion_tokens=usage.get("completion_tokens", 0),
                total_tokens=usage.get("total_tokens", 0),
                is_fallback=True,
            )
        raise


def _build_system(context_chunks: list[dict] | None = None, system_extra: str = "") -> str:
    system = _system_prompt()
    if system_extra:
        system += "\n\n" + system_extra
    if context_chunks:
        system += "\n\n--- RELEVANT DOCUMENTS ---\n"
        for i, chunk in enumerate(context_chunks, 1):
            source = chunk.get("filename", "unknown")
            dtype = chunk.get("doc_type", "")
            system += f"\n[Source {i}: {source} ({dtype})]\n{chunk['text']}\n"
        system += "\n--- END DOCUMENTS ---\n"
    return system


async def chat(
    user_message: str,
    context_chunks: list[dict] | None = None,
    conversation_history: list[dict] | None = None,
    system_extra: str = "",
) -> LLMResult:
    system = _build_system(context_chunks, system_extra)
    messages = [{"role": "system", "content": system}]
    for h in conversation_history or []:
        messages.append({"role": h["role"], "content": h["content"]})
    messages.append({"role": "user", "content": user_message})
    return await _call_llm(messages)
