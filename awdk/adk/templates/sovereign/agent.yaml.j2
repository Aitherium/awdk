# AitherADK agent definition for {{ agent_display_name }}
# Generated by: adk create {{ agent_name }} --template sovereign

name: {{ agent_name }}
description: {{ agent_description }}

instructions: |
  {{ system_prompt | indent(2) }}

model: auto

capabilities:
  - LLM_INFERENCE
  - LLM_EMBED
  - MEMORY_READ
  - MEMORY_WRITE
  - FILE_READ
  - NET_HTTP

tools:
  - {{ agent_name }}.tools:rag_search
  - {{ agent_name }}.tools:document_ingest

memory:
  kind: file
  path: ./.aither/{{ agent_name }}.jsonl

# Portal registration metadata (consumed by ADK portal client)
portal:
  app_id: {{ agent_name }}
  category: knowledge
  icon: file-text
  url: https://{{ agent_name }}.aitherium.com
  embed_url: https://{{ agent_name }}.aitherium.com/?embedded=true
  config_endpoint: /api/config/embed
  health_endpoint: /api/health
  capabilities:
    - chat
    - rag
    - document_extraction
    - content_generation

# Federation settings (multi-instance deployment)
federation:
  enabled: true
  heartbeat_interval: 60

# Brain pack reference (the templatization layer)
brain_pack: {{ pack_id }}
