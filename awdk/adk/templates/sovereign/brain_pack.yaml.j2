# Brain pack for {{ agent_display_name }}.
# Customize the agent's personality, document types, roles, and UI labels.
# Generated by: adk create {{ agent_name }} --template sovereign

id: {{ pack_id }}
app_name: {{ agent_display_name }}
company_name: {{ company_name }}

system_prompt: |
  {{ system_prompt | indent(2) }}

welcome_message: |
  {{ welcome_message | indent(2) }}

roles:
  admin:
    description: Full access — manages uploads, reviews outputs, trains preferences
    permissions: [upload, query, generate, export, manage_preferences]
  member:
    description: Can upload documents and query, but cannot export or manage
    permissions: [upload, query]
  viewer:
    description: Read-only — can query and view, no uploads or generation
    permissions: [query]

workspace_role_map:
  owner: admin
  admin: admin
  member: member
  viewer: viewer
default_role: viewer

doc_types:
  - id: document
    label: Document
  - id: other
    label: Other

extraction_schemas: []

features:
  auto_export_spreadsheets: false
  watch_directory: false

ui_labels:
  upload_button: Upload documents
  generate_button: Generate document
  staff_label: Team
  project_label: Projects

safety:
  auto_approve_threshold: 0.90
  min_compound_confidence: 0.60
  proposal_ttl_hours: 24
  irreversible_actions:
    - document.publish
    - email.send_external
  safe_actions:
    - email.draft
    - document.save_draft
    - query.rag
  citation_enforcement: true
  trace_retention_days: 30

platform:
  enabled: false
  forge:
    enabled: false
    allowed_agents: [demiurge, hydra, athena, scribe]
    max_effort: 7
    max_concurrent: 3
  expeditions:
    enabled: false
  council:
    enabled: false
  reasoning:
    enabled: false
  business_pilot:
    enabled: false
  swarm:
    enabled: false
