# {{ agent_display_name }} — AitherOS network overlay
# Usage: docker compose -f docker-compose.aitheros.yml up -d
# Joins the existing AitherOS Docker network for service discovery.

services:
  {{ agent_name }}:
    build: ./backend
    ports:
      - "{{ port }}:{{ port }}"
    environment:
      - {{ env_prefix }}LLM_PROVIDER=aitheros
      - {{ env_prefix }}AITHEROS_URL=http://aitheros-microschedule:8150
      - {{ env_prefix }}QDRANT_URL=http://qdrant:6333
      - {{ env_prefix }}PORT={{ port }}
      - {{ env_prefix }}DEPLOYMENT_MODE=hybrid
    volumes:
      - ./data:/app/data
      - ./brain_pack.yaml:/app/brain_pack.yaml:ro
    networks:
      - aitheros
    restart: unless-stopped

networks:
  aitheros:
    external: true
    name: aitheros_default
