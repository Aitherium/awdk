# {{ agent_display_name }} — standalone Docker Compose
# Usage: docker compose up -d

services:
  {{ agent_name }}:
    build: ./backend
    ports:
      - "{{ port }}:{{ port }}"
    environment:
      - {{ env_prefix }}LLM_PROVIDER=portal
      - {{ env_prefix }}QDRANT_URL=http://qdrant:6333
      - {{ env_prefix }}PORT={{ port }}
    volumes:
      - ./data:/app/data
      - ./brain_pack.yaml:/app/brain_pack.yaml:ro
      - ./.aither:/app/.aither
    depends_on:
      - qdrant
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - aitheros

  qdrant:
    image: qdrant/qdrant:latest
    ports:
      - "6333:6333"
    volumes:
      - qdrant_data:/qdrant/storage
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:6333/healthz"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
    restart: unless-stopped
    networks:
      - aitheros

{% if addons is defined and addons %}
{% for addon in addons %}
  aitheros-addon-{{ addon.id }}:
    image: {{ addon.image }}
    container_name: aitheros-addon-{{ addon.id }}
    ports:
      - "{{ addon.default_port }}:{{ addon.default_port }}"
{% if addon.volumes is defined and addon.volumes %}
    volumes:
{% for vol in addon.volumes %}
      - aitheros-addon-{{ addon.id }}-{{ vol.name }}:{{ vol.path }}
{% endfor %}
{% endif %}
{% if addon.env_defaults is defined and addon.env_defaults %}
    environment:
{% for key, val in addon.env_defaults.items() %}
      {{ key }}: "{{ val }}"
{% endfor %}
{% endif %}
{% if addon.health_check is defined and addon.health_check.path %}
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:{{ addon.default_port }}{{ addon.health_check.path }}"]
      interval: {{ addon.health_check.interval | default("30s") }}
      timeout: 5s
      start_period: 15s
      retries: 3
{% endif %}
{% if addon.resources is defined and addon.resources.gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
{% endif %}
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - aitheros
{% endfor %}
{% endif %}

volumes:
  qdrant_data:
{% if addons is defined and addons %}
{% for addon in addons %}
{% if addon.volumes is defined and addon.volumes %}
{% for vol in addon.volumes %}
  aitheros-addon-{{ addon.id }}-{{ vol.name }}:
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

networks:
  aitheros:
    name: aitheros_default
    external: true
