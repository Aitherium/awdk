# Aitherium onboard manifest for {{ agent_display_name }}.
# Generated by: adk create {{ agent_name }} --template sovereign

agent_name: {{ agent_name }}
version: 0.1.0
description: |
  {{ agent_description }}
author: Aitherium
mode: remote
isolation: standard

agent_url: https://{{ agent_name }}.your-company.com
health_endpoint: /api/health

capabilities_requested:
  - llm_inference
  - llm_embed
  - memory_read
  - memory_write
  - document_analysis
  - file_upload

skills:
  - id: rag_search
    name: Document Knowledge Search
    description: Search the company knowledge base.
    tags: [rag, search, documents]
    examples:
      - Find documents about the latest project.
      - What do we know about topic X?

  - id: generate_document
    name: Document Generation
    description: Draft documents grounded in the knowledge base.
    tags: [generation, documents]
    examples:
      - Generate a summary of our recent work.

resources:
  workspace_quota_gb: 5
  max_concurrent_requests: 10
  model: auto

billing_plan: builder
register_a2a: true
