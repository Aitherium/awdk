# Deep Research Studio — configuration
# Copy this file to ".env" and set ONE inference path. Nothing leaves your machine
# except calls to the LLM provider you choose (and the web searches the agent runs).

# ── Option A: Anthropic / Claude (recommended) ──────────────────────────────
ANTHROPIC_API_KEY=

# ── Option B: OpenAI (also covers Codex) ────────────────────────────────────
# OPENAI_API_KEY=

# ── Option C: Local Ollama (fully offline, no key) ──────────────────────────
# Leave the keys blank and run Ollama. Override the host if it isn't the default.
# OLLAMA_HOST=http://localhost:11434

# ── Optional overrides ──────────────────────────────────────────────────────
# Force a provider regardless of which keys are set: anthropic | openai | ollama
# DEEP_RESEARCH_PROVIDER=anthropic
# Pick a specific model (else the provider default, e.g. claude-sonnet-4-6).
# DEEP_RESEARCH_MODEL=claude-sonnet-4-6
# PORT=8130

# ── Codex / ChatGPT OAuth (EXPERIMENTAL — see engine/codex_oauth.py) ─────────
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_BASE=https://auth.openai.com

# ── Dev only: run against a local awdk checkout instead of the PyPI pkg ─
# AITHER_ADK_PATH=
