{
  "awdk-bridge": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -S -m adk.harnesses.antigravity_hooks SessionStart",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -S -m adk.harnesses.antigravity_hooks PreInvocation",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -m adk.harnesses.antigravity_hooks PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -m adk.harnesses.antigravity_hooks PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -S -m adk.harnesses.antigravity_hooks PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -S -m adk.harnesses.antigravity_hooks Stop",
        "timeout": 20
      }
    ]
  }
}
