# Site Ingest Studio — environment configuration
# Copy this to .env and fill in your API keys for your chosen LLM provider.

# LLM Provider selection (anthropic, openai, deepseek, llamacpp)
# SITE_INGEST_PROVIDER=anthropic
# SITE_INGEST_MODEL=claude-opus-4-1  # optional; uses provider default if unset

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# llama.cpp (local, no key needed — set AITHER_LLAMACPP_URL if not 127.0.0.1:8080)
# AITHER_LLAMACPP_URL=http://127.0.0.1:8080

# Optional: AitherBrowser for screenshot capture (if available)
# AITHER_BROWSER_URL=http://localhost:8200

# Optional: custom data directory (defaults to .data/ next to serve.py)
# AITHER_DATA_DIR=/path/to/data

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
