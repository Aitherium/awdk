# Every value here is optional: the defaults in src/aitherium.ts are the local
# platform. Copy to .env to change one. Never commit a token.

# OpenAI-compatible model endpoint and the model to ask for.
# AITHER_LLM_BASE_URL=https://127.0.0.1:8150/v1
# AITHER_MODEL=bonsai2-27b-5090
# AITHER_MODEL_CONTEXT=16384

# MCP gateway. Local by default; the hosted one is https://mcp.aitherium.com/mcp
# AITHER_MCP_URL=http://localhost:8182/mcp

# Gateway tools to mount, comma separated. The gateway lists ~1,900 tools, far
# more than a local model's context holds, so the agent mounts only these.
# AITHER_MCP_TOOLS=time_now,catalog_browse

# Your sign-in. Unset = read the session `adk login` wrote (~/.aither/session-bearer).
# AITHER_MCP_TOKEN=
